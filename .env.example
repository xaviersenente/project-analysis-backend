# Configuration de l'analyse : copier ce fichier en .env (hors de Git) et le compléter

# Données (hors de Git) : un dossier par promo, data/<promo>/ (s1-sae, s3-sae…),
# choisi par la commande : npm run analyser -- s1-sae --tous
# À ne fixer que pour forcer un autre dossier (ils remplacent alors le choix de la promo)
# DATA_DIR=./data/s1-sae
# PROMO_FILE=./data/s1-sae/promo.json

# Cache des clones et des maquettes Figma (hors de Git)
CACHE_DIR=./cache

# GitHub (facultatif) : jeton en lecture pour les dépôts privés et un quota d'API plus large
GITHUB_TOKEN=

# Maquette Figma (G11) : jeton personnel, scopes « File content » et « File versions » en lecture
# Figma → Settings → Security → Personal access tokens. Sans lui, G11 passe en « Non mesurable »
FIGMA_TOKEN=

# Outils externes (facultatif) : chemins de Chrome et de Java
# Sans eux, les contrôles en navigateur et la validation W3C passent en « Non mesurable »
CHROME_PATH=
JAVA_BIN=java

# IA, voie API seulement (promo.json : "ia": { "mode": "api", … }) ; inutile avec la voie Claude Code
# ANTHROPIC_API_KEY=
