# Configuration de l'application
# Copier ce fichier en .env et ajuster les valeurs

# Port du serveur
PORT=3000

# Environnement (development, production, test)
NODE_ENV=development

# Timeouts (en millisecondes)
DEFAULT_TIMEOUT=30000
LIGHTHOUSE_TIMEOUT=3000
VALIDATION_TIMEOUT=5000

# Limites
MAX_FILE_SIZE=5242880
MAX_CONCURRENT_ANALYSIS=3

# Sécurité (S2) : jeton exigé sur toutes les routes
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=

# CORS : domaine(s) du frontend, séparés par des virgules
CORS_ORIGIN=http://localhost:4321

# Données (hors de Git) : dossier des résultats et fichier de promo
DATA_DIR=./data
PROMO_FILE=./data/promo.json

# Maquette Figma (G11) : jeton personnel, scopes « File content » et « File versions » en lecture
# Figma → Settings → Security → Personal access tokens. Sans lui, G11 passe en « Non mesurable »
FIGMA_TOKEN=

# Logs
LOG_LEVEL=info

# Outils externes (facultatif) : chemins de Chromium et de Java sur le serveur
# Sans eux, les étapes Lighthouse et validation W3C passent en « Non mesurable »
CHROME_PATH=
JAVA_BIN=java
